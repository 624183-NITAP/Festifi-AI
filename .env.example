# FestiFi AI Environment Variables
# Server-side only: never prefix with NEXT_PUBLIC_

# Optional: Google Gemini API key for live AI generation.
# If omitted or invalid, FestiFi AI seamlessly runs in high-fidelity deterministic offline/demo mode.
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Google Gemini Model ID (Defaults to gemini-2.0-flash)
# Supported options: gemini-2.0-flash, gemini-2.5-flash, gemini-1.5-flash-latest
GEMINI_MODEL=gemini-2.0-flash

# Application Configuration
NODE_ENV=development
APP_URL=http://localhost:3000
